# =============================================================================
# Repro-in-a-Box — Environment Configuration
# Copy this file to `.env` in the project root and fill in your keys.
# =============================================================================

# --- Solari (browser infrastructure) ---
# Get your key at https://console.getsolari.com → API Keys
SOLARI_API_KEY=slr_live_your_key_here

# --- OpenRouter (LLM reasoning layer) ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
MODEL_PROVIDER=openrouter
MODEL_NAME=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Target application (BuggyBoard demo) ---
TARGET_URL=https://buggyboard.vercel.app
TEST_USERNAME=demo@buggyboard.io
TEST_PASSWORD=demo1234
BUGGYBOARD_API_URL=http://localhost:3001

# --- Repro server ---
REPRO_SERVER_PORT=4000
REPRO_DATA_DIR=./.repro

# --- Agent settings ---
MAX_REPRO_ATTEMPTS=10
AGENT_VIEWPORT_WIDTH=1280
AGENT_VIEWPORT_HEIGHT=800
